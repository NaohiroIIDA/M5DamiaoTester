diff --git a/src/can.c b/src/can.c
index 3975b44..e1ab6a8 100644
--- a/src/can.c
+++ b/src/can.c
@@ -55,6 +55,15 @@ void can_init(void)
     __HAL_RCC_GPIOC_CLK_ENABLE();
     __HAL_RCC_GPIOA_CLK_ENABLE();
 
+    // Openlight Labs CANable 2.0: PA0 is the transceiver STBY pin (pulled high on the board).
+    // Drive it low to take the transceiver out of standby (same as normaldotcom/canable2-fw).
+    GPIO_InitStruct.Pin = GPIO_PIN_0;
+    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
+    GPIO_InitStruct.Pull = GPIO_PULLDOWN;
+    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;
+    HAL_GPIO_Init(GPIOA, &GPIO_InitStruct);
+    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_0, 0);
+
     GPIO_InitStruct.Pin = GPIO_PIN_13;
     GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
     GPIO_InitStruct.Pull = GPIO_PULLDOWN;
